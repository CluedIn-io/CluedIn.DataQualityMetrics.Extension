# Copy to .env for local runs. .env is git-ignored; never commit real credentials.

# --- CluedIn -----------------------------------------------------------------
CLUEDIN_DOMAIN=example.com
CLUEDIN_ORG_NAME=exampleorg
CLUEDIN_ACCESS_TOKEN=
CLUEDIN_VERIFY_TLS=true

# --- Metrics configuration ---------------------------------------------------
METRICS_CONFIG=config/metrics.json

# --- SQL Server --------------------------------------------------------------
METRICS_SQL_SERVER=
METRICS_SQL_DATABASE=
METRICS_SQL_USER=
METRICS_SQL_PASSWORD=
# METRICS_SQL_PORT=1433
# METRICS_SQL_CONN_PROPERTIES=

# Overrides "sql.table" in the configuration file.
METRICS_TABLE=dbo.MetricHistory
